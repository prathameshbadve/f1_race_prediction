# ENVIRONMENT
ENVIRONMENT=example

# MINIO (CHANGE BASED ON ENVIRONMENT)
ACCESS_KEY=minioadmin
SECRET_KEY=minioadmin
DOCKER_ENDPOINT=http://minio:9000
LOCAL_ENDPOINT=http://localhost:9000
REGION=ap-south-1

# AWS

# BUCKETS
RAW_DATA_BUCKET=f1-data-raw
PROCESSED_DATA_BUCKET=f1-data-processed
MODEL_BUCKET=f1-model-artifacts

# REDIS
REDIS_LOCAL_HOST=localhost
REDIS_DOCKER_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redisadmin

# REDIS COMMANDER
REDIS_COMMANDER_USER=redisuser
REDIS_COMMANDER_PASSWORD=redispass

# DB (CHANGE BASED ON ENVIRONMENT)
DB_BACKEND=postgresql
DB_HOST=postgres
DB_LOCAL_HOST=localhost
DB_PORT=5432
DB_DEFAULT_NAME=postgres
DB_NAME=data_warehouse
DB_USER=postgres
DB_PASSWORD=postgres

# VARIABLES FOR MLFLOW
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=username
AWS_SECRET_ACCESSKEY=password

# PROJECT LOGGING
LOG_DIR=monitoring/logs/
LOG_LEVEL=INFO

# FASTF1
# Cache
FASTF1_CACHE_DIR=data/external/fastf1_cache
FASTF1_CACHE_ENABLED=True
FASTF1_FORCE_RENEW_CACHE=False

# Logging
FASTF1_LOG_LEVEL=INFO

# Connection
FASTF1_REQUEST_TIMEOUT=30
FASTF1_MAX_RETRIES=3
FASTF1_RETRY_DELAY=5

# Testing
FASTF1_INCLUDE_TESTING=False

# Years to ingest
START_YEAR=2018
END_YEAR=2025
